# Optional settings. Copy this file to .env and fill in only what you need.
# Neither value is a secret: both are public addresses that end up in the built site.

# The https endpoint of a form service (for example a Formspree form: https://formspree.io/f/xxxxxxxx).
# Leave empty and the contact form opens the visitor's email app instead of sending.
VITE_CONTACT_ENDPOINT=

# The final https address of the deployed site (for example https://vijaypn.dev).
# Used for the canonical link and the absolute social-preview image URLs.
VITE_SITE_URL=
